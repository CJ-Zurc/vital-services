PORT=4001
LOG_LEVEL=info
HTTP_LOGGING_ENABLED=true

# PayMongo sandbox secret. Never commit a real key.
PAYMONGO_SECRET_KEY=sk_test_change_me
PAYMONGO_PUBLIC_KEY=pk_test_change_me

# Must match vital-web VITAL_INTERNAL_SERVICE_KEY.
VITAL_INTERNAL_SERVICE_KEY=change-me-vital-internal-service-key

# Internal callback target on the shared vital-network.
VITAL_WEB_URL=http://vital-web-app:3001
