{
  "name": "vital-services",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "build": "npm run generate && node scripts/eda/clean-output.mjs && tsc -p tsconfig.json",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate --config prisma/core.config.ts && prisma generate --config prisma/integrations.config.ts",
    "migrate:core": "prisma migrate deploy --config prisma/core.config.ts",
    "migrate:integrations": "prisma migrate deploy --config prisma/integrations.config.ts",
    "start:eda": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "test:eda": "node --import tsx --test --test-concurrency=1 test/eda-*.test.ts",
    "eda:inventory": "node scripts/eda/inventory.mjs",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.js test/eda-*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CJ-Zurc/vital-services.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CJ-Zurc/vital-services/issues"
  },
  "homepage": "https://github.com/CJ-Zurc/vital-services#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1075.0",
    "@aws-sdk/s3-request-presigner": "3.1075.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "amqplib": "^0.10.9",
    "axios": "^1.16.0",
    "canonicalize": "2.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.19.0",
    "pg": "^8.21.0",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@prisma/internals": "7.10.1",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.20.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3"
  }
}
