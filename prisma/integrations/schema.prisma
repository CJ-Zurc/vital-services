// Initial extraction from development schema SHA256 7ba131a2a7b1747f4be51366a4fce50482c4c209cfcefa4bd4d1df3984a06f34
generator client {
  provider = "prisma-client"
  moduleFormat = "cjs"
  output = "../../src/eda/generated/integrations"
}

datasource db {
  provider = "postgresql"
}


enum PaymentProvider {
  gcash
  maya
  paymongo
}

enum PaymentStatus {
  unpaid
  pending
  pending_verification
  approved
  paid
  failed
  rejected
  refund_pending
  refunded
  refund_failed
  non_refundable
}

enum PaymentOperationStatus {
  pending
  completed
  failed
  unknown
}

model GoogleMeetConnection {
  id             String   @id @default(uuid())
  doctorId       String   @unique
  googleSubject  String?
  email          String?
  scopes         String[] @default([])
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  status         String   @default("disconnected")
  revision       Int      @default(0)
  refreshLease   String?
  refreshLeaseUntil DateTime?
  updatedAt      DateTime @updatedAt
  generations    GoogleMeetGeneration[]
  @@map("google_meet_connections")
}

model GoogleMeetOAuthState {
  id             String @id
  doctorId       String
  authId         String
  bindingHash    String
  secret         String
  returnTo       String
  expiresAt      DateTime
  @@index([expiresAt])
  @@map("google_meet_oauth_states")
}

model GoogleMeetGeneration {
  id             String @id @default(uuid())
  doctorId       String
  connectionId   String
  connection     GoogleMeetConnection @relation(fields: [connectionId], references: [id])
  connectionRevision Int
  requestId      String
  purpose        String
  appointmentId  String
  status         String @default("creating")
  spaceName      String?
  meetingUrl     String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  claimedAppointmentId String? @unique
  @@unique([doctorId, requestId])
  @@index([createdAt])
  @@index([doctorId, createdAt])
  @@map("google_meet_generations")
  version Int @default(0)
  billingLineageId String
  providerAttemptStartedAt DateTime?
}

model Payment {
  id              String          @id @default(uuid())
  appointmentId   String          @unique
  paymentProvider PaymentProvider
  providerMode    String          @default("sandbox")
  proofFilePath   String?
  referenceNumber String?
  amount          Decimal?        @db.Decimal(10, 2)
  currency        String          @default("PHP")
  status          PaymentStatus   @default(unpaid)
  checkoutSessionId String?       @unique
  checkoutUrl     String?
  paymentIntentId String?
  paymongoPaymentId String?
  refundId        String?
  refundReason    String?
  refundEligible  Boolean?
  latestWebhookEventId String?    @unique
  rejectionReason String?
  submittedAt     DateTime        @default(now())
  verifiedAt      DateTime?
  paidAt          DateTime?
  failedAt        DateTime?
  refundRequestedAt DateTime?
  refundedAt      DateTime?

  invoice Invoice?

  @@map("payments")
  version Int @default(0)
}

model PaymentOperation {
  id            String                 @id @default(uuid())
  operationKey  String                 @unique
  operationType String
  requestHash   String
  status        PaymentOperationStatus @default(pending)
  providerId    String?
  result        Json?
  error         String?
  correlationId String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, updatedAt])
  @@map("payment_operations")
}

model Invoice {
  id               String      @id @default(uuid())
  paymentId        String      @unique
  payment          Payment     @relation(fields: [paymentId], references: [id])
  appointmentId    String
  filePath         String?
  patientName      String?
  doctorName       String?
  consultationDate DateTime?   @db.Date
  service          String?
  paymentMethod    String?
  generatedAt      DateTime    @default(now())

  @@map("invoices")
}

model OutboxEvent {
  id               String    @id @default(uuid())
  eventType        String
  schemaVersion    Int       @default(1)
  producer         String
  aggregateId      String
  aggregateVersion Int
  correlationId    String
  causationId      String?
  occurredAt       DateTime  @default(now())
  payload          Json
  status           String    @default("pending")
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  leaseOwner       String?
  leaseUntil       DateTime?
  publishedAt      DateTime?
  lastErrorCode    String?
  @@index([status, nextAttemptAt, leaseUntil])
  @@index([producer, aggregateId, aggregateVersion])
  @@map("outbox_events")
}

model InboxEvent {
  consumerId  String
  eventId     String
  processedAt DateTime @default(now())
  @@id([consumerId, eventId])
  @@map("inbox_events")
}

model CommandOperation {
  id            String    @id @default(uuid())
  actorId       String
  action        String
  resourceId    String
  operationId   String
  requestHash   String
  status        String    @default("pending")
  result        Json?
  errorCode     String?
  leaseOwner    String?
  leaseUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([actorId, operationId])
  @@index([status, leaseUntil])
  @@map("command_operations")
}


model VideoResource {
  id               String   @id @default(uuid())
  appointmentId    String   @unique
  doctorId         String
  billingLineageId String
  version          Int      @default(0)
  provider         String   @default("gmeet")
  meetingUrl       String?
  normalizedMeetingUrl String?
  meetingUrlHash    String?  @unique
  validationStatus String
  googleSpaceName  String?
  generationId     String?  @unique
  linkGeneratedAt  DateTime?
  linkSavedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([doctorId, billingLineageId])
  @@map("video_resources")
}

model MeetGenerationQuota {
  doctorId         String
  billingLineageId String
  purpose          String
  attemptsStarted  Int      @default(0)
  updatedAt        DateTime @updatedAt
  @@id([doctorId, billingLineageId, purpose])
  @@map("meet_generation_quotas")
}

model SagaParticipant {
  operationId      String
  participant      String
  sourceAppointmentId String
  replacementAppointmentId String
  expectedVersion  Int
  requestHash      String
  status           String   @default("prepared")
  preparedAt       DateTime @default(now())
  finalizedAt      DateTime?
  @@id([operationId, participant])
  @@index([status, preparedAt])
  @@map("saga_participants")
}

model IntegrationDelivery {
  id            String   @id @default(uuid())
  eventId       String
  correlationId String
  destination   String
  requestId     String
  requestHash   String
  aggregateId   String
  sourceVersion Int
  payload       Json
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseOwner    String?
  leaseUntil    DateTime?
  receiptId     String?
  lastErrorCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([destination, requestId])
  @@index([status, nextAttemptAt, leaseUntil])
  @@map("integration_deliveries")
}
