model VideoResource {
  id               String   @id @default(uuid())
  appointmentId    String   @unique
  doctorId         String
  billingLineageId String
  version          Int      @default(0)
  provider         String   @default("gmeet")
  meetingUrl       String?
  normalizedMeetingUrl String?
  meetingUrlHash    String?  @unique
  validationStatus String
  googleSpaceName  String?
  generationId     String?  @unique
  linkGeneratedAt  DateTime?
  linkSavedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([doctorId, billingLineageId])
  @@map("video_resources")
}

model MeetGenerationQuota {
  doctorId         String
  billingLineageId String
  purpose          String
  attemptsStarted  Int      @default(0)
  updatedAt        DateTime @updatedAt
  @@id([doctorId, billingLineageId, purpose])
  @@map("meet_generation_quotas")
}

model SagaParticipant {
  operationId      String
  participant      String
  sourceAppointmentId String
  replacementAppointmentId String
  expectedVersion  Int
  requestHash      String
  status           String   @default("prepared")
  preparedAt       DateTime @default(now())
  finalizedAt      DateTime?
  @@id([operationId, participant])
  @@index([status, preparedAt])
  @@map("saga_participants")
}

model IntegrationDelivery {
  id            String   @id @default(uuid())
  eventId       String
  correlationId String
  destination   String
  requestId     String
  requestHash   String
  aggregateId   String
  sourceVersion Int
  payload       Json
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseOwner    String?
  leaseUntil    DateTime?
  receiptId     String?
  lastErrorCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([destination, requestId])
  @@index([status, nextAttemptAt, leaseUntil])
  @@map("integration_deliveries")
}
