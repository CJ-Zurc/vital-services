NODE_ENV=production
VITAL_EDA_PRIVATE_HTTP=true
VITAL_EDA_ENABLED=true
VITAL_EDA_PROFILE_WRITES_ENABLED=true
VITAL_EDA_CONSUMERS_ENABLED=true
VITAL_EDA_DELIVERY_ENABLED=true
VITAL_EDA_PROFILE_SYNC_ENABLED=true
VITAL_EDA_PAYMENT_ENABLED=false
VITAL_EDA_PAYMENT_RECONCILE_ENABLED=false
VITAL_EDA_APPOINTMENT_ENABLED=true
VITAL_EDA_APPOINTMENT_MAINTENANCE_ENABLED=true
VITAL_EDA_RECORDS_ENABLED=true
VITAL_EDA_RECORDS_ARTIFACTS_ENABLED=true
VITAL_EDA_VIDEO_ENABLED=true
VITAL_EDA_VIDEO_MAINTENANCE_ENABLED=false
VITAL_EDA_MESSAGING_ENABLED=true
VITAL_EDA_MESSAGE_HOLDS_ENABLED=true
VITAL_EDA_MESSAGING_RETENTION_SCAN_ENABLED=false
VITAL_EDA_MESSAGING_RETENTION_ENABLED=false
VITAL_EDA_SSE_ENABLED=true
VITAL_EDA_COMPLETION_ENABLED=true
VITAL_EDA_PROFILE_QR_ENABLED=true
# Runtime launcher derives per-process DB URLs from that process's mounted secrets.
# Required for enabled Payment; sk_test_ credential only, supplied privately.
VITAL_PAYMENT_APP_ORIGIN=https://vital.example.invalid
PAYMONGO_SECRET_KEY=
# Records: separate restricted storage principal; never MinIO root credentials.
VITAL_RECORDS_KEYRING_FILE=/run/vital-config/records-keyring.json
VITAL_EHR_RECORDS_PUBLIC_KEYS_FILE=/run/vital-config/ehr-records-public.json
VITAL_AUTH_INTERNAL_URL=http://auth-api:8000
VITAL_SERVICES_AUTH_PROFILE_KEY=
VITAL_RECORDS_STORAGE_ENDPOINT=http://minio:9000
VITAL_RECORDS_STORAGE_PUBLIC_ENDPOINT=https://gateway.example.invalid/media/vital-web
VITAL_RECORDS_STORAGE_BUCKET=vital-records
VITAL_RECORDS_STORAGE_REGION=us-east-1
VITAL_RECORDS_STORAGE_ACCESS_KEY=
VITAL_RECORDS_STORAGE_SECRET_KEY=
VITAL_RECORDS_QUARANTINE_PREFIX=quarantine/records/
VITAL_RECORDS_FINAL_PREFIX=records/final/
VITAL_RECORDS_CLAMAV_SOCKET=/run/clamav/clamd.sock
VITAL_RECORDS_CLAMAV_CONFIG=/run/clamav/clamd.conf
VITAL_RECORDS_FONT_REGULAR_FILE=/run/vital-config/regular.ttf
VITAL_RECORDS_FONT_BOLD_FILE=/run/vital-config/bold.ttf
# Appointment recovery is read-only for existing authorized EHR operations.
VITAL_EHR_INTERNAL_URL=http://uhse-ehr-api:8008
VITAL_SERVICES_EHR_RECOVERY_KEY=
# Meet is a separate authorization purpose, never Auth Google-login tokens.
VITAL_VIDEO_GOOGLE_ENABLED=false
VITAL_VIDEO_APP_ORIGIN=https://vital.example.invalid
VITAL_VIDEO_GOOGLE_CLIENT_ID=
VITAL_VIDEO_GOOGLE_CLIENT_SECRET_FILE=/run/vital-config/meet-client-secret
VITAL_VIDEO_GOOGLE_REDIRECT_URI=https://vital.example.invalid/api/doctor/google-meet/callback
VITAL_VIDEO_KEYRING_FILE=/run/vital-config/meet-keyring.json
# Messaging keys must be identical for API/worker and retain old versions.
MESSAGE_ENCRYPTION_KEYS=
MESSAGE_ACTIVE_KEY_VERSION=
MESSAGE_RETENTION_APPROVED=false
MESSAGE_RETENTION_POLICY_APPROVAL_ID=
VITAL_EDA_API_PORT=8443
VITAL_SERVICE_CA_FILE=/run/secrets/service_ca
VITAL_API_TLS_CERT_FILE=/run/secrets/api-cert.pem
VITAL_API_TLS_KEY_FILE=/run/secrets/api-key.pem
VITAL_BFF_SIGNING_KEY_ID=vital-bff-v1
VITAL_BFF_SIGNING_PUBLIC_KEY_FILE=/run/secrets/bff-public.pem
VITAL_BFF_PREVIOUS_PUBLIC_KEYS_FILE=
VITAL_SERVICES_AUTH_REGISTRATION_KEY=
# Profile-owned payment QR assets use a distinct restricted storage principal.
VITAL_PROFILE_QR_STORAGE_ENDPOINT=http://minio:9000
VITAL_PROFILE_QR_STORAGE_BUCKET=vital-profile
VITAL_PROFILE_QR_STORAGE_REGION=us-east-1
VITAL_PROFILE_QR_STORAGE_ACCESS_KEY=
VITAL_PROFILE_QR_STORAGE_SECRET_KEY=
VITAL_PROFILE_QR_CLAMAV_SOCKET=/run/clamav/clamd.sock
VITAL_PROFILE_QR_CLAMAV_CONFIG=/run/clamav/clamd.conf

# Appointment access (required independently of NLP flags). Provision distinct 32-byte base64 keys.
VITAL_APPOINTMENT_ACCESS_KEYS={}
VITAL_APPOINTMENT_ACCESS_ACTIVE_KEY_VERSION=1
VITAL_APPOINTMENT_ACCESS_DIGEST_KEY=
