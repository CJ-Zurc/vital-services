# Separate opt-in target runtime; never point these URLs at the legacy/shared database.
VITAL_EDA_ENABLED=false
VITAL_EDA_PROFILE_WRITES_ENABLED=false
VITAL_EDA_CONSUMERS_ENABLED=false
VITAL_EDA_DELIVERY_ENABLED=false
VITAL_EDA_API_PORT=8443
VITAL_CORE_DATABASE_URL=postgresql://vital_core_api:REPLACE@vital-services-db:5432/vital_core
VITAL_INTEGRATIONS_DATABASE_URL=postgresql://vital_integrations_api:REPLACE@vital-services-db:5432/vital_integrations
# Worker mode overrides URLs with separately scoped vital_core_worker/vital_integrations_worker identities.
VITAL_CORE_MIGRATION_URL=postgresql://vital_core_migrator:REPLACE@vital-services-db:5432/vital_core
VITAL_INTEGRATIONS_MIGRATION_URL=postgresql://vital_integrations_migrator:REPLACE@vital-services-db:5432/vital_integrations
VITAL_DATABASE_CA_FILE=/run/secrets/vital-db-ca.pem
VITAL_SERVICE_CA_FILE=/run/secrets/vital-service-ca.pem
VITAL_API_TLS_CERT_FILE=/run/secrets/vital-api-cert.pem
VITAL_API_TLS_KEY_FILE=/run/secrets/vital-api-key.pem
VITAL_BFF_SIGNING_KEY_ID=vital-bff-v1
VITAL_BFF_PREVIOUS_PUBLIC_KEYS_FILE=
VITAL_BFF_SIGNING_PUBLIC_KEY_FILE=/run/secrets/vital-bff-public.pem
VITAL_RABBITMQ_URL=amqps://vital_worker:REPLACE@vital-rabbitmq:5671/vital
VITAL_RABBITMQ_CA_FILE=/run/secrets/vital-broker-ca.pem
VITAL_EDA_PROVISION_BROKER=false
VITAL_RABBITMQ_PROVISION_URL=
VITAL_AUDIT_URL=http://audit-service:8081
AUDIT_VITAL_INGEST_KEY=
VITAL_NOTIFICATION_URL=http://notification-api:8000
VITAL_NOTIFICATION_INGEST_KEY=
# Google/PayMongo and Web cleanup remain gated until the owning workflows migrate.
