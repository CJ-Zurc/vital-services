# Separate opt-in target runtime; never point these URLs at the legacy/shared database.
VITAL_EDA_ENABLED=false
VITAL_SERVICES_AUTH_REGISTRATION_KEY=
# Messaging and deletion require separate reviewed activation; never enable on shared staging here.
VITAL_EDA_MESSAGING_ENABLED=false
VITAL_EDA_MESSAGE_HOLDS_ENABLED=false
VITAL_EDA_MESSAGING_RETENTION_SCAN_ENABLED=false
VITAL_EDA_MESSAGING_RETENTION_ENABLED=false
MESSAGE_RETENTION_APPROVED=false
MESSAGE_RETENTION_POLICY_APPROVAL_ID=
MESSAGE_ENCRYPTION_KEYS=
MESSAGE_ACTIVE_KEY_VERSION=
# Video ownership and worker recovery are separate opt-ins; separate Meet consent remains required.
VITAL_EDA_VIDEO_ENABLED=false
VITAL_EDA_VIDEO_MAINTENANCE_ENABLED=false
VITAL_VIDEO_GOOGLE_ENABLED=false
VITAL_VIDEO_APP_ORIGIN=http://localhost:3001
VITAL_VIDEO_GOOGLE_CLIENT_ID=
VITAL_VIDEO_GOOGLE_CLIENT_SECRET_FILE=
VITAL_VIDEO_GOOGLE_REDIRECT_URI=
VITAL_VIDEO_KEYRING_FILE=
# Records checkpoint stays off until all storage/EHR/scanner contracts pass acceptance.
VITAL_EDA_RECORDS_ENABLED=false
VITAL_EDA_RECORDS_ARTIFACTS_ENABLED=false
VITAL_RECORDS_KEYRING_FILE=
VITAL_EHR_RECORDS_PUBLIC_KEYS_FILE=
VITAL_SERVICES_AUTH_PROFILE_KEY=
VITAL_RECORDS_STORAGE_ENDPOINT=
VITAL_RECORDS_STORAGE_PUBLIC_ENDPOINT=
VITAL_RECORDS_STORAGE_BUCKET=
VITAL_RECORDS_STORAGE_REGION=
VITAL_RECORDS_STORAGE_ACCESS_KEY=
VITAL_RECORDS_STORAGE_SECRET_KEY=
VITAL_RECORDS_QUARANTINE_PREFIX=quarantine/records/
VITAL_RECORDS_FINAL_PREFIX=records/final/
VITAL_RECORDS_CLAMAV_SOCKET=
VITAL_RECORDS_CLAMAV_CONFIG=
VITAL_RECORDS_FONT_REGULAR_FILE=
VITAL_RECORDS_FONT_BOLD_FILE=
VITAL_EDA_PROFILE_WRITES_ENABLED=false
VITAL_EDA_CONSUMERS_ENABLED=false
VITAL_EDA_DELIVERY_ENABLED=false
VITAL_EDA_PROFILE_SYNC_ENABLED=false
VITAL_EDA_PAYMENT_ENABLED=false
VITAL_EDA_PAYMENT_RECONCILE_ENABLED=false
VITAL_EDA_APPOINTMENT_ENABLED=false
VITAL_EDA_APPOINTMENT_MAINTENANCE_ENABLED=false
VITAL_PAYMENT_APP_ORIGIN=http://localhost:3001
# Explicit sandbox-only target credential; never put a live key here.
PAYMONGO_SECRET_KEY=
VITAL_EDA_API_PORT=8443
# Reference only, never a shared API/worker/tools env file. Root process-specific
# templates are authoritative. The Docker launcher derives runtime database URLs
# from separate mounted api/worker passwords at postgres:5432. Migrator URLs belong
# only to explicitly selected tools and are never injected into application processes.
VITAL_DATABASE_CA_FILE=/run/secrets/db-ca.pem
VITAL_SERVICE_CA_FILE=/run/secrets/service-ca.pem
VITAL_API_TLS_CERT_FILE=/run/secrets/api-cert.pem
VITAL_API_TLS_KEY_FILE=/run/secrets/api-key.pem
VITAL_BFF_SIGNING_KEY_ID=vital-bff-v1
VITAL_BFF_PREVIOUS_PUBLIC_KEYS_FILE=
VITAL_BFF_SIGNING_PUBLIC_KEY_FILE=/run/secrets/bff-public.pem
# Worker broker URL is launcher-derived from rabbit_runtime_password at rabbitmq:5671.
VITAL_RABBITMQ_CA_FILE=/run/secrets/broker-ca.pem
VITAL_EDA_PROVISION_BROKER=false
# Broker provisioning URL is launcher-derived in manual tools only.
VITAL_AUDIT_URL=https://audit.example.invalid
AUDIT_VITAL_INGEST_KEY=
VITAL_NOTIFICATION_URL=https://notification.example.invalid
VITAL_NOTIFICATION_INGEST_KEY=
VITAL_AUTH_INTERNAL_URL=https://auth.example.invalid
VITAL_SERVICES_AUTH_STALE_KEY=
VITAL_EHR_INTERNAL_URL=https://ehr.example.invalid
VITAL_SERVICES_EHR_MIRROR_KEY=
VITAL_SERVICES_EHR_RECOVERY_KEY=
# Google and full Web cleanup remain gated until the owning workflows migrate.
VITAL_EDA_SSE_ENABLED=false
VITAL_EDA_COMPLETION_ENABLED=false
VITAL_EDA_PROFILE_QR_ENABLED=false
# Required only for Profile QR activation; scoped away from clinical objects.
VITAL_PROFILE_QR_STORAGE_ENDPOINT=
VITAL_PROFILE_QR_STORAGE_BUCKET=vital-profile
VITAL_PROFILE_QR_STORAGE_REGION=us-east-1
VITAL_PROFILE_QR_STORAGE_ACCESS_KEY=
VITAL_PROFILE_QR_STORAGE_SECRET_KEY=
VITAL_PROFILE_QR_CLAMAV_SOCKET=/run/clamav/clamd.sock
VITAL_PROFILE_QR_CLAMAV_CONFIG=/run/clamav/clamd.conf
